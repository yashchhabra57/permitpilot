# Copy to .env and adjust. Every setting has a working default.

# SQLite file for local development. For PostgreSQL:
# PERMITPILOT_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/permitpilot
PERMITPILOT_DATABASE_URL=sqlite:///./permitpilot.db

# Optional. With a key, new ordinances are extracted by an LLM (checked against the source
# text); without one, the deterministic rule extractor is used.
PERMITPILOT_ANTHROPIC_API_KEY=
PERMITPILOT_LLM_MODEL=claude-opus-5-5

# Job queue
PERMITPILOT_JOB_LEASE_SECONDS=60
PERMITPILOT_JOB_MAX_ATTEMPTS=5
PERMITPILOT_JOB_BACKOFF_BASE_SECONDS=30
PERMITPILOT_JOB_BACKOFF_CAP_SECONDS=3600

# Load the sample ordinance on first start.
PERMITPILOT_SEED_ON_STARTUP=true
# Allows POST /api/jobs/run-due?as_of=... (time travel for demos). Set false in production.
PERMITPILOT_DEMO_MODE=true
